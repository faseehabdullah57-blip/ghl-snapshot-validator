# =============================================================================
# GoHighLevel (GHL) Snapshot Validator - Environment Configuration
# =============================================================================
# Copy this file to `.env` and populate with your Sub-Account Location ID
# and GHL API v2 Private Integration / OAuth Bearer Token.

# Target GoHighLevel Sub-Account Location ID
GHL_LOCATION_ID=loc_your_subaccount_location_id_here

# GoHighLevel API v2 Bearer Token (requires locations.readonly, locations/customFields.write,
# locations/tags.write, locations/customValues.write, opportunities.readonly scopes)
GHL_API_KEY=pit-your-private-integration-token-here

# Optional: Custom path to master blueprint JSON schema
GHL_SCHEMA_FILE=schemas/master_agency_blueprint.json
